{
  "info": {
    "name": "Postmortem Action Tracker Postman Collection",
    "description": "Tracks action items from postmortems and incident reviews to completion. \nSolves the chronic problem of postmortem action items that never get done — \n\"we identified 8 action items, 2 got done, the same incident happened again \n3 months later.\" Enforces ownership, deadlines, verification, and surfaces \naging items before they become repeat incidents.\n\nOpenAPI version: 3.0.3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://actiontracker.forgesphere.lightning.com/v1",
      "type": "string",
      "description": "Override with the base URL of the deployed Kong gateway."
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "q",
      "value": "",
      "type": "string",
      "description": "Full-text search across title and description."
    },
    {
      "key": "owner",
      "value": "",
      "type": "string",
      "description": "Filter by owner (engineer email)."
    },
    {
      "key": "ownerTeam",
      "value": "",
      "type": "string",
      "description": "Filter by owning team."
    },
    {
      "key": "status",
      "value": "",
      "type": "string",
      "description": "Filter by status."
    },
    {
      "key": "priority",
      "value": "",
      "type": "string",
      "description": "Filter by priority."
    },
    {
      "key": "category",
      "value": "",
      "type": "string",
      "description": "Filter by fix category."
    },
    {
      "key": "incidentId",
      "value": "",
      "type": "string",
      "description": "Filter to items from a specific incident."
    },
    {
      "key": "overdueOnly",
      "value": "",
      "type": "string",
      "description": "Only return overdue items."
    },
    {
      "key": "agingDays",
      "value": "",
      "type": "string",
      "description": "Only return items older than this many days."
    },
    {
      "key": "sortBy",
      "value": "",
      "type": "string",
      "description": "Sort order."
    },
    {
      "key": "page",
      "value": "",
      "type": "string",
      "description": "Page number (zero-based)."
    },
    {
      "key": "size",
      "value": "",
      "type": "string",
      "description": "Number of items per page."
    },
    {
      "key": "itemId",
      "value": "",
      "type": "string",
      "description": "Unique identifier of the action item."
    },
    {
      "key": "scope",
      "value": "",
      "type": "string",
      "description": "Aggregation scope."
    },
    {
      "key": "scopeId",
      "value": "",
      "type": "string",
      "description": "Required when scope = TEAM or ENGINEER."
    },
    {
      "key": "windowDays",
      "value": "",
      "type": "string",
      "description": "Analysis window in days."
    },
    {
      "key": "includeRepeatIncidentCorrelation",
      "value": "",
      "type": "string",
      "description": "Whether to analyze how often unresolved items correlate with repeat incidents."
    }
  ],
